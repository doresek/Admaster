# ════════════════════════════════════════════
# AdMaster Pro — Environment Variables
# Copy to .env.local and fill in values
# NEVER commit .env.local to git!
# ════════════════════════════════════════════

# ── Supabase ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key

# ── Anthropic (Claude AI) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-key

# ── Meta (Facebook) API ───────────────────────
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
# Webhook verify token (any random string)
META_WEBHOOK_VERIFY_TOKEN=random-secret-string
# Graph API version used by the central config (lib/meta-config.ts).
# Defaults to v21.0 if unset. Legacy routes still pin v19.0 (follow-up).
META_GRAPH_VERSION=v21.0
# Secret used to SIGN the OAuth state JWT (CSRF). Use a distinct random
# string (>= 32 chars). Falls back to ENCRYPTION_KEY if unset.
META_OAUTH_STATE_SECRET=another-long-random-secret-min-32-chars
# OAuth redirect URI — MUST byte-for-byte match a Valid OAuth Redirect URI
# on the Meta app. Defaults to the prod Vercel URL; override for localhost.
META_OAUTH_REDIRECT_URI=https://admaster-three.vercel.app/api/meta/oauth/callback
# Optional: Facebook Login *for Business* configuration id. When set, the
# authorize flow uses Business Login and returns a System-User token.
# Leave UNSET in dev to use classic scope login (works with a Tester account).
META_LOGIN_CONFIG_ID=

# ── Stripe (payments) ────────────────────────
STRIPE_SECRET_KEY=sk_live_...or sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://admaster-pro.co.il
# For local dev:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Ideogram (image generation) ────
IDEOGRAM_API_KEY=your-key
